# Ustawienia serwera Apache (lh.pl) dla strony Fundacji Tomy.
# Każda sekcja <IfModule> działa tylko wtedy, gdy serwer ma dany moduł,
# więc brak modułu niczego nie psuje.

# --- Kodowanie i strona błędu ---------------------------------------------
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# --- Przekierowania ----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Każdy inny adres -> https://fundacjatomy.pl (jednym skokiem, od razu na HTTPS):
  #    www.fundacjatomy.pl, tomy.org.pl, www.tomy.org.pl, fundacjatomy.com, www.fundacjatomy.com
  RewriteCond %{HTTP_HOST} !^fundacjatomy\.pl$ [NC]
  RewriteRule ^ https://fundacjatomy.pl%{REQUEST_URI} [R=301,L]

  # 2) http:// -> https://
  #    Drugi warunek chroni przed pętlą, gdy HTTPS obsługuje serwer pośredniczący.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Bezpieczeństwo ----------------------------------------------------------
<IfModule mod_headers.c>
  # Przeglądarka ma zawsze łączyć się przez HTTPS (przez rok).
  # Przez zwykłe HTTP przeglądarki ten nagłówek ignorują, więc działa tylko po HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Nie zgaduj typu plików
  Header always set X-Content-Type-Options "nosniff"
  # Nie pozwalaj osadzać strony w ramkach (nigdzie, także na tej samej domenie)
  Header always set X-Frame-Options "DENY"
  # Content-Security-Policy: przeglądarka uruchomi tylko skrypty z tej domeny, statystyki wykr.es
  # i jeden skrypt wpisany w <head> strony głównej (rozpoznawany po skrócie sha256).
  # UWAGA: po każdej zmianie tego skryptu w index.html trzeba tu wpisać nowy skrót
  # (workflow deploy-ftp.yml sprawdza to przed wysyłką i przerwie ją, jeśli skrót się nie zgadza).
  # Zmiana adresu statystyk wymaga zmiany adresu wykr.es w script-src i connect-src.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-w9zwLgaq2CvrStGRzOR3MstRfkyuRjE+79Vr45CEwUo=' https://mws03-53316.wykr.es; connect-src 'self' https://mws03-53316.wykr.es; img-src 'self'; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  # Okno strony nie dzieli kontekstu z oknami otwartymi z innych stron
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Innym stronom przekazuj tylko domenę, nie pełny adres
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Strona nie potrzebuje kamery, mikrofonu ani lokalizacji
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Typy plików -------------------------------------------------------------
AddType font/woff2 .woff2
AddType image/x-icon .ico
AddType image/avif .avif
AddType image/webp .webp

# --- Kompresja (szybsze ładowanie) ----------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript image/svg+xml image/x-icon
</IfModule>

# --- Pamięć podręczna przeglądarki ----------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  # HTML zawsze świeży, żeby zmiany treści były widoczne od razu
  ExpiresByType text/html "access plus 0 seconds"
  # CSS i JS mają w adresie wersję (?v=...), która zmienia się przy każdej zmianie pliku,
  # więc mogą być trzymane długo — nowa wersja i tak zostanie pobrana od razu.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
